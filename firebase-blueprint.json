{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Premium cinematography products (LUTs, presests, stock footage)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category"]
    },
    "Film": {
      "title": "Film",
      "description": "Portfolio items representing film projects",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "director": { "type": "string" },
        "category": { "type": "string", "enum": ["OTT", "Branded", "Music Video", "Unscripted"] },
        "videoUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "description": { "type": "string" },
        "year": { "type": "number" }
      },
      "required": ["title", "category", "thumbnailUrl"]
    },
    "Order": {
      "title": "Order",
      "description": "Store orders placed by users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "totalAmount", "status", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "photoURL": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Customizable configurations for the website pages, slide speed, and profile team members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "settings": { "type": "object", "description": "Arbitrary key-value map of site settings" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["settings"]
    },
    "JobApplication": {
      "title": "JobApplication",
      "description": "Candidates who applied for positions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "message": { "type": "string" },
        "resumeUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "role"]
    },
    "ProjectInquiry": {
      "title": "ProjectInquiry",
      "description": "User inquiries and contact submissions with project details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "emailOrPhone": { "type": "string" },
        "orgName": { "type": "string" },
        "orgType": { "type": "string" },
        "briefUrl": { "type": "string" },
        "briefOriginalName": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "emailOrPhone", "subject", "message"]
    }
  },
  "firestore": {
    "/configs/{configId}": {
      "schema": "SiteConfig",
      "description": "Dynamic configurations for the website pages and settings"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store products"
    },
    "/films/{filmId}": {
      "schema": "Film",
      "description": "Film portfolio"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "User orders"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/job_applications/{applicationId}": {
      "schema": "JobApplication",
      "description": "Job applicant submissions"
    },
    "/project_inquiries/{inquiryId}": {
      "schema": "ProjectInquiry",
      "description": "User submitted project inquiries"
    }
  }
}
